{
  "name": "pse-tracker",
  "version": "1.0.0",
  "description": "Local PSE stock dashboard",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start": "npm run build && node local-server.ts",
    "start:lan": "npm run build && HOST=0.0.0.0 node local-server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "build:api": "tsc -p tsconfig.api.json",
    "build:vercel": "npm run build && npm run build:api && node scripts/assemble.mjs"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "gridstack": "^11.5.1",
    "lightweight-charts": "^4.2.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
